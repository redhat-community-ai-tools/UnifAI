environments:
  default:
    values:
      - ./values/shared-resource-values.yaml
---

helmDefaults:
  createNamespace: false
  wait: false
  historyMax: 1

releases:

  - name: unifai-mongodb
    chart: ./shared-resources/mongodb
    wait: true
    timeout: 300
    values:
      - {{- toYaml .Values.mongodb | nindent 8 }}

  - name: unifai-qdrant
    chart: ./shared-resources/qdrant
    wait: true
    timeout: 300
    values:
      - {{- toYaml .Values.qdrant | nindent 8 }}

  - name: unifai-rabbitmq
    chart: ./shared-resources/rabbitmq
    wait: true
    values:
      - {{- toYaml .Values.rabbitmq | nindent 8 }}

  - name: unifai-redis-config
    chart: ./shared-resources/redis-config
    wait: true

  - name: unifai-redis
    chart: ./shared-resources/redis
    needs:
      - unifai-redis-config
    wait: true
    values:
      - {{- toYaml .Values.redis | nindent 8 }}
    hooks:
      - events: ["presync"]
        showlogs: true
        command: bash
        args:
        - "./scripts/redis-presync.sh"

  - name: unifai-redis-insight
    chart: ./shared-resources/redis-insight
    needs:
      - unifai-redis
    wait: true
    values:
     - {{- toYaml (index .Values "redis-insight") | nindent 8 }}

  - name: unifai-temporal
    chart: ./shared-resources/temporal
    wait: true
    values:
     - {{- toYaml .Values.temporal | nindent 8 }}

  - name: unifai-shared-config
    chart: ./shared-resources/shared-config
    wait: true
    needs:
      - unifai-mongodb
      - unifai-qdrant
      - unifai-rabbitmq
      - unifai-redis
      - unifai-redis-insight
      - unifai-temporal
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: bash
        args:
        - "./scripts/shared-resources-postsync.sh"
