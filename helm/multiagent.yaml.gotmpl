environments:
  default:
    values:
      - ./values/multiagent-resource-values.yaml
---

helmDefaults:
  createNamespace: false
  wait: false
  historyMax: 1

releases:

  - name: unifai-multiagent-be
    chart: ./multiagent/be
    wait: true
    #timeout: 300
    values:
      - ./values/global-config.yaml
      - {{- toYaml .Values.multiagent_server | nindent 8 }}
    hooks:
      - events: ["presync"]
        showlogs: true
        command: bash
        args:
        - "./scripts/multiagent-presync.sh"

  - name: unifai-multiagent-temporal-worker
    chart: ./multiagent/temporal-worker
    wait: true
    #timeout: 300
    values:
      - ./values/global-config.yaml
      - {{- toYaml .Values.multiagent_temporal_worker | nindent 8 }}


  - name: multiagent-config
    chart: ./multiagent/multiagent-config
    wait: true
    needs:
      - unifai-multiagent-be
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: bash
        args:
        - "./scripts/multiagent-postsync.sh"


